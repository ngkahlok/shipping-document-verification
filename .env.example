# Copy to .env (gitignored) for local use, or export these directly in your
# shell. On Streamlit Community Cloud, set the same keys in the app's
# Secrets panel (.streamlit/secrets.toml format) instead -- app.py bridges
# them into os.environ automatically.

# Required to use the Gemini classifier backend at all.
GEMINI_API_KEY=

# "rules" (default, no API calls) or "gemini".
SDOC_CLASSIFIER="rules"

# Optional overrides -- sensible defaults are baked into pipeline/gemini_classify.py.
# GEMINI_MODEL=gemini-flash-latest
# SDOC_GEMINI_MAX_WORKERS=6
# SDOC_GEMINI_MAX_RETRIES=4
# SDOC_GEMINI_CONFIDENT_MARGIN=20
